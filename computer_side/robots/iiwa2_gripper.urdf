<?xml version="1.0"?>
<robot name="iiwa">

  <link name="world"/>

  <material name="gray">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>

  <link name="iiwa_base" type="fixed"/>

  <joint name="iiwa_root_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="world"/>
      <child link="iiwa_base"/>
  </joint>

  <joint name="iiwa_base_joint" type="fixed">
      <origin rpy="0.0 0 0" xyz="0 0 0"/>
      <parent link="iiwa_base"/>
      <child link="link_0"/>
  </joint>

  <link name="link_0">
      <visual>
        <origin rpy="0.0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="meshes/visual/base_link.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="meshes/collision/base_link.stl"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="-0.1 0 0.07" rpy="0 0 0"/>
        <mass value="5"/>
        <inertia ixx="0.05"  ixy="0"  ixz="0" iyy="0.06" iyz="0" izz="0.03" />
      </inertial>
  </link>
  <link name="link_1">
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="meshes/visual/link_1.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="meshes/collision/link_1.stl"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 -0.03 0.12" rpy="0 0 0"/>
        <mass value="4"/>
        <inertia ixx="0.1"  ixy="0"  ixz="0" iyy="0.09" iyz="0" izz="0.02" />
      </inertial>
  </link>
  <link name="link_2">
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="meshes/visual/link_2.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="meshes/collision/link_2.stl"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.0003 0.059 0.042" rpy="0 0 0"/>
        <mass value="4"/>
        <inertia ixx="0.05"  ixy="0"  ixz="0" iyy="0.018" iyz="0" izz="0.044" />
      </inertial>
  </link>
  <link name="link_3">
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="meshes/visual/link_3.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="meshes/collision/link_3.stl"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0.03 0.13" rpy="0 0 0"/>
        <mass value="3"/>
        <inertia ixx="0.08"  ixy="0"  ixz="0" iyy="0.075" iyz="0" izz="0.01" />
      </inertial>
  </link>
  <link name="link_4">
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="meshes/visual/link_4.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="meshes/collision/link_4.stl"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0.067 0.034" rpy="0 0 0"/>
        <mass value="2.7"/>
        <inertia ixx="0.03"  ixy="0"  ixz="0" iyy="0.01" iyz="0" izz="0.029" />
      </inertial>
  </link>
  <link name="link_5">
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="meshes/visual/link_5.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="meshes/collision/link_5.stl"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.0001 0.021 0.076" rpy="0 0 0"/>
        <mass value="1.7"/>
        <inertia ixx="0.02"  ixy="0"  ixz="0" iyy="0.018" iyz="0" izz="0.005" />
      </inertial>
  </link>
  <link name="link_6">
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="meshes/visual/link_6.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="meshes/collision/link_6.stl"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0.0006 0.0004" rpy="0 0 0"/>
        <mass value="1.8"/>
        <inertia ixx="0.025"  ixy="0"  ixz="0" iyy="0.0136" iyz="0" izz="0.0247" />
      </inertial>
  </link>
  <link name="link_7">
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0.0"/>
        <material name="gray"/>
        <geometry>
          <mesh filename="meshes/visual/link_7.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0.0"/>
        <geometry>
          <mesh filename="meshes/collision/link_7.stl"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.02" rpy="0 0 0"/>
        <mass value="0.4285714285714286"/> <!--this is for the MFT Pneumatisch flange-->
        <inertia ixx="0.01"  ixy="0"  ixz="0" iyy="0.01" iyz="0" izz="0.01" />
      </inertial>
  </link>

  <link name="tool0"/>

  <link name="gripper_base_link">
    <inertial>
      <origin xyz="0 0 0.0055" rpy="0 0 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.001245" ixy="0" ixz="0" iyy="0.002728" iyz="0" izz="0.003051"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/visual/base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_gray">
        <color rgba="0.75 0.75 0.72 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/collision/base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="gripper_left_jaw_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.000151" ixy="0" ixz="0" iyy="0.000258" iyz="0" izz="0.000156"/>
    </inertial>
    <visual>
      <origin xyz="-0.041639558 -0.013 -0.04754972" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/visual/tip.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_gray">
        <color rgba="0.75 0.75 0.72 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="-0.041639558 -0.013 -0.04754972" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/collision/tip.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="gripper_right_jaw_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.000151" ixy="0" ixz="0" iyy="0.000258" iyz="0" izz="0.000156"/>
    </inertial>
    <visual>
      <origin xyz="0.041639558 0.013 -0.04754972" rpy="0 0 3.14159265359"/>
      <geometry>
        <mesh filename="meshes/visual/tip.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_gray">
        <color rgba="0.75 0.75 0.72 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.041639558 0.013 -0.04754972" rpy="0 0 3.14159265359"/>
      <geometry>
        <mesh filename="meshes/collision/tip.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="tool1"/>

  <joint name="joint_a1" type="revolute">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <parent link="link_0"/>
      <child link="link_1"/>
      <axis xyz="0 0 1"/>
      <limit effort="300" lower="-2.9321531433504737" upper="2.9321531433504737" velocity="10"/>
  </joint>
  <joint name="joint_a2" type="revolute">
      <origin rpy="0 0 0" xyz="-0.00043624 0 0.36"/>
      <parent link="link_1"/>
      <child link="link_2"/>
      <axis xyz="0 1 0"/>
      <limit effort="300" lower="-2.0594885173533086" upper="2.0594885173533086" velocity="10"/>
  </joint>
  <joint name="joint_a3" type="revolute">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <parent link="link_2"/>
      <child link="link_3"/>
      <axis xyz="0 0 1"/>
      <limit effort="300" lower="-2.9321531433504737" upper="2.9321531433504737" velocity="10"/>
  </joint>
  <joint name="joint_a4" type="revolute">
      <origin rpy="0 0 0" xyz="0.00043624 0 0.42"/>
      <parent link="link_3"/>
      <child link="link_4"/>
      <axis xyz="0 -1 0"/>
      <limit effort="300" lower="-2.0594885173533086" upper="2.0594885173533086" velocity="10"/>
  </joint>
  <joint name="joint_a5" type="revolute">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <parent link="link_4"/>
      <child link="link_5"/>
      <axis xyz="0 0 1"/>
      <limit effort="300" lower="-2.9321531433504737" upper="2.9321531433504737" velocity="10"/>
  </joint>
  <joint name="joint_a6" type="revolute">
      <origin rpy="0 0 0" xyz="0 0 0.4"/>
      <parent link="link_5"/>
      <child link="link_6"/>
      <axis xyz="0 1 0"/>
      <limit effort="300" lower="-2.0594885173533086" upper="2.0594885173533086" velocity="10"/>
  </joint>
  <joint name="joint_a7" type="revolute">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <parent link="link_6"/>
      <child link="link_7"/>
      <axis xyz="0 0 1"/>
      <limit effort="300" lower="-3.01941960595019" upper="3.01941960595019" velocity="10"/>
  </joint>
  <joint name="joint_a7-tool0" type="fixed">
      <origin rpy="0 0 0" xyz="0 0 0.126"/>
      <parent link="link_7"/>
      <child link="tool0"/>
      <axis xyz="0 0 0"/>
  </joint>

  <joint name="joint_tool0-gripper" type="fixed">
      <origin rpy="0 0 1.5708" xyz="0 0 0.049"/>
      <parent link="tool0"/>
      <child link="gripper_base_link"/>
      <axis xyz="0 0 0"/>
  </joint>

  <joint name="left_jaw_joint" type="fixed">
    <parent link="gripper_base_link"/>
    <child link="gripper_left_jaw_link"/>
    <origin xyz="-0.04488 0.000189 0.09354972" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="0.068" effort="120" velocity="0.05"/>
    <dynamics damping="8" friction="1"/>
  </joint>

  <!-- The second jaw uses the same actuator command and moves outward along -Y. -->
  <joint name="right_jaw_joint" type="fixed">
    <parent link="gripper_base_link"/>
    <child link="gripper_right_jaw_link"/>
    <origin xyz="0.04488 0.000189 0.09354972" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="0" upper="0.068" effort="120" velocity="0.05"/>
    <dynamics damping="8" friction="1"/>
    <mimic joint="left_jaw_joint" multiplier="1" offset="0"/>
  </joint>

  <joint name="joint_tool1" type="fixed">
      <origin rpy="0 -1.5708 0" xyz="0 0 0.18"/>
      <parent link="tool0"/>
      <child link="tool1"/>
      <axis xyz="0 0 0"/>
  </joint>

  <!-- <transmission name="left_jaw_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="left_jaw_joint">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="linear_actuator">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission> -->

  <gazebo reference="link_0"><material>Gazebo/Grey</material><mu1>0.2</mu1><mu2>0.2</mu2></gazebo>
  <gazebo reference="link_1"><material>Gazebo/Orange</material><mu1>0.2</mu1><mu2>0.2</mu2></gazebo>
  <gazebo reference="link_2"><material>Gazebo/Orange</material><mu1>0.2</mu1><mu2>0.2</mu2></gazebo>
  <gazebo reference="link_3"><material>Gazebo/Orange</material><mu1>0.2</mu1><mu2>0.2</mu2></gazebo>
  <gazebo reference="link_4"><material>Gazebo/Orange</material><mu1>0.2</mu1><mu2>0.2</mu2></gazebo>
  <gazebo reference="link_5"><material>Gazebo/Orange</material><mu1>0.2</mu1><mu2>0.2</mu2></gazebo>
  <gazebo reference="link_6"><material>Gazebo/Orange</material><mu1>0.2</mu1><mu2>0.2</mu2></gazebo>
  <gazebo reference="link_7"><material>Gazebo/Grey</material><mu1>0.2</mu1><mu2>0.2</mu2></gazebo>
</robot>
